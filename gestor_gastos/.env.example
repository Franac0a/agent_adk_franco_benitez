# Modelo a utilizar (formato LiteLLM: proveedor/modelo)
MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=tu_api_key_aqui

# Alternativas:
# MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=tu_api_key_aqui
#
# MODEL=ollama_chat/llama3.1   (modelo local con Ollama, sin API key)

# Oculta el aviso de ADK sobre usar Gemini vía LiteLLM
ADK_SUPPRESS_GEMINI_LITELLM_WARNINGS=true
